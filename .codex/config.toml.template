# Copy into your Codex config only if your Codex runtime supports MCP servers.
# Replace all absolute paths before use. Do not commit personal config.

[mcp_servers.epan]
type = "stdio"
command = "/ABSOLUTE/PATH/TO/epan-<target>/bin/epan-mcp-env"
args = []

[mcp_servers.epan.env]
EPAN_PCAP_DIR = "/ABSOLUTE/PATH/TO/pcaps"
EPAN_OUTPUT_DIR = "/ABSOLUTE/PATH/TO/epan-output"
EPAN_TIMEOUT = "120s"
EPAN_MAX_OUTPUT_BYTES = "8388608"
