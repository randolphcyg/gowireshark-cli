{
  "mcpServers": {
    "gowireshark": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/TO/gowireshark-cli-<target>/bin/gowireshark-mcp-env",
      "args": [],
      "env": {
        "GOWIRESHARK_PCAP_DIR": "/ABSOLUTE/PATH/TO/pcaps",
        "GOWIRESHARK_OUTPUT_DIR": "/ABSOLUTE/PATH/TO/gowireshark-output",
        "GOWIRESHARK_TIMEOUT": "120s",
        "GOWIRESHARK_MAX_OUTPUT_BYTES": "8388608"
      }
    }
  }
}
